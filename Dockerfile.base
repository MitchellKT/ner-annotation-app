# syntax=docker/dockerfile:1
#
# Base image: all third-party dependencies (Python + Node toolchain and
# packages), but none of the app's own source. Build it where the internet is
# reachable, push it to the on-prem registry, and rebuild only when
# dependencies change (backend/pyproject.toml, frontend/package.json or
# frontend/package-lock.json).
#
#   docker build -f Dockerfile.base -t <registry>/ner-annotator-base:<tag> .
#   docker push <registry>/ner-annotator-base:<tag>

# ── Node toolchain + frontend packages ────────────────────────────
FROM node:20-slim AS node
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci \
 && npm cache clean --force \
 # npm can exit 0 on network failures; make sure the toolchain is really there.
 && test -x node_modules/.bin/vite && test -x node_modules/.bin/tsc

# ── Base image ────────────────────────────────────────────────────
FROM python:3.12-slim AS base

# Node runtime + npm, so the app image can build the frontend offline.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# Frontend node_modules live where the app image will copy frontend/ to.
# (.dockerignore excludes node_modules, so that COPY won't clobber them.)
COPY --from=node /app/frontend/node_modules /app/frontend/node_modules

# Python dependencies: install the backend with all extras to pull in its
# dependency tree, then remove the package itself so only deps remain.
# hatchling/editables are kept so the app image can install the backend
# with --no-build-isolation (no network needed).
WORKDIR /app
COPY backend/pyproject.toml ./backend/
RUN mkdir -p backend/ner_annotator && touch backend/ner_annotator/__init__.py \
 && pip install --no-cache-dir hatchling editables "./backend[mongo,dev]" \
 && pip uninstall -y ner-annotator \
 && rm -rf backend
